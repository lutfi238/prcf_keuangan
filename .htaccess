# Prevent caching issues with Ngrok
# This file helps prevent redirect caching problems

# Block access to sensitive files
<Files ".env">
    Require all denied
</Files>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|md|txt|log)$">
    Require all denied
</FilesMatch>

# Disable caching for PHP files
<FilesMatch "\.(php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# Disable caching for HTML files
<FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# Force redirects to be fresh
RewriteEngine On

# Prevent caching of redirects
RewriteCond %{QUERY_STRING} ^(.*)$
RewriteRule ^(.*)$ - [E=no-cache:1]

# Add no-cache header for all requests
Header always set Cache-Control "no-cache, no-store, must-revalidate"
Header always set Pragma "no-cache"
Header always set Expires "0"
